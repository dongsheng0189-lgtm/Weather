# Human-edited direct dependencies. Compile to requirements.txt:
#   bash app_unified/scripts/lock-deps.sh            # re-lock, no bumps
#   bash app_unified/scripts/lock-deps.sh --upgrade  # bump to latest allowed
# CI deps-lock.yml fails if requirements.txt is out of sync — always commit both.
#
# torch CPU-only: resolved from the PyTorch CPU index → NO nvidia-cuda-* (~2GB saved).
# prod is 2 CPU / 8GB / no GPU, so the CUDA stack was pure dead weight.
--extra-index-url https://download.pytorch.org/whl/cpu

