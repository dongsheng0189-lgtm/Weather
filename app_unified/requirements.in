# CPU build matches current torch-2.12.0; drops the entire nvidia-cuda-* dependency tree.
torch==2.12.0+cpu

# face_recognition is intentionally NOT listed here. It is installed --no-deps in
# Dockerfile.base: dlib + face_recognition_models come from app_unified/wheels/
# (compiled / 100MB), and face_recognition itself is pure-python. Listing it would
# pull dlib + face_recognition_models into the lock and force a PyPI recompile/redownload
# under --require-hashes, defeating the wheels optimization. Its runtime deps
# (numpy / Pillow / Click) ARE locked (numpy/Pillow direct above, Click via flask).
