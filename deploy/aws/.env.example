# 複製成 .env 填真值。.env 不要進 git、權限設 600。
#
# ⚠️ Zeabur 2026-08 / 10-14 兩次資安事件外洩了環境變數，
#    所有「曾經放在 Zeabur」的憑證都要當成已外洩，一律換新。
#    唯一例外是 DB_ENCRYPTION_KEY（見下方說明）。

# ── 網域 ────────────────────────────────────────────────────────────
DOMAIN=airweather-detection.com

# ── 資料庫（同台的 postgres 容器）──────────────────────────────────
# 2026-11-06 改用自架：RDS 每月 $42，試架階段不划算。
#
# ❗ 只需要填密碼。DATABASE_URL 由 docker-compose.yml 自動組成
#    postgresql://weather:<這個密碼>@postgres:5432/weather
#    —— 不要在這裡另外寫 DATABASE_URL，compose 的 environment 會蓋掉它，
#    兩邊不一致只會讓你查半天。
#
# ⚠️ 密碼請用英數字加 - _ .，避開 @ : / ? # &
#    這些字元在連線字串裡有特殊意義，會被解析成分隔符號。
# 產生：python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# ── 兩把金鑰 ────────────────────────────────────────────────────────
# ❗ DB_ENCRYPTION_KEY：必須與 Zeabur **逐字相同**，否則所有加密欄位會顯示
#    「⚠️ 無法解密（請聯絡管理員）」。這把已外洩，但不能在搬遷時換——
#    換掉要跑重新加密（migrate_encrypt_fields.py），排在觀察期之後另案處理。
DB_ENCRYPTION_KEY=

# 🔴 SECRET_KEY：**一定要設**。
#    2026-11-06 查核：Zeabur 上從來沒設過這個變數，正式站一直在用 config.py:22 的
#    fallback「dev-secret-key-change-in-production」——這個字串公開在 GitHub repo 裡，
#    任何人都能用它偽造 session cookie 冒充任意帳號登入。這是現行漏洞，不是外洩風險。
#    換掉的代價：所有使用者登出一次（session 存在 cookie，不在 Redis）。
#    產生：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# ── Cloudflare R2（全部換新 token）────────────────────────────────
# R2_PUBLIC_URL 不用設：config.py 有定義但全專案沒有任何地方讀它，Zeabur 上也沒設。
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── 外部 API（全部換新金鑰，並檢查舊的有沒有被盜刷）──────────────
# ANTHROPIC_API_KEY 不用設：Zeabur 沒設，且 app_unified 只在 config.py 定義、沒有使用處。
OPENWEATHERMAP_API_KEY=
GEMINI_API_KEY=

# ── CORS（照抄 Zeabur 原值，兩個網域都要）──────────────────────────
ALLOWED_ORIGINS=https://airweather-detection.com,https://www.airweather-detection.com

# ── 不要設 ─────────────────────────────────────────────────────────
# PORT                 → compose 已設
# REDIS_URI            → compose 已設（指向內網 redis 容器）
# REDIS_URL / REDIS_CONNECTION_STRING
#                      → 殘留會蓋掉 REDIS_URI，絕對不要設
# SESSION_COOKIE_SECURE→ compose 已設 true
# FLASK_DEV_MODE       → 正式環境不設
# MONITOR_INGEST_URL / MONITOR_INGEST_TOKEN
#                      → monitor 不部署；不設則 monitor_ship 自動 no-op
# DATABASE_URL         → 由 compose 依 POSTGRES_PASSWORD 自動組出來
# RATELIMIT_STORAGE_URL→ 程式目前實際走 memory://，設了也沒作用
# REDIS_URL            → Zeabur 上設的是公網 IP；AWS 走 compose 的內網 REDIS_URI，
#                        這裡設了會蓋掉內網設定
# APP_MODE / GEMINI_MODEL / HUB_BLOCK_THRESHOLD
#                      → Zeabur 都沒設，走程式預設即可
# R2_PUBLIC_URL / ANTHROPIC_API_KEY
#                      → config.py 有定義但無使用處，Zeabur 也沒設
# PASSWORD / POSTGRESQL_HOST / POSTGRESQL_PORT
# NOTES_SAL_HOST / WEATHER_HOST / NOTES_HOST / OLLAMA_HOST
#                      → Zeabur 自動注入的殘留，程式碼完全沒讀
